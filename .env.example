# ===== 后端（FastAPI）配置 =====
# 运行环境：local / dev / prod
APP_ENV=local
# 监听地址与端口；前端 vite 代理默认指向 127.0.0.1:8000，改端口时前端也要同步改
APP_HOST=127.0.0.1
APP_PORT=8000
# 允许跨域的前端来源，多个用英文逗号分隔；留空则使用本地默认值
CORS_ORIGINS=
# 启动时是否灌入示例数据（含能力验证从待参加到未通过的完整样例）
SEED_DEMO_DATA=1

# ===== 前端（Vite）配置（见 frontend/.env.development）=====
# dev 模式下 /api 代理目标；与 APP_HOST/APP_PORT 保持一致
# VITE_PROXY_TARGET=http://127.0.0.1:8000
